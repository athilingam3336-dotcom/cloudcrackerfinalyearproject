# Application configuration
APP_NAME="CloudCrackers API"
ENVIRONMENT="development"
DEBUG=true

# Server configuration
HOST="0.0.0.0"
PORT=8000

# Database configuration
MONGODB_URL="mongodb://localhost:27017"
DB_NAME="cloudcrackers"

# JWT configuration
JWT_SECRET_KEY="your_super_secret_jwt_signing_key_change_me_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS configuration
ALLOWED_ORIGINS=["https://cloudcrackerfinalyearproject.onrender.com","http://localhost:8081","http://localhost:3000"]

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Meta Instagram OAuth Configuration
INSTAGRAM_CLIENT_ID="2262885951230627"
INSTAGRAM_CLIENT_SECRET="your_instagram_client_secret_from_meta_developer_console"
INSTAGRAM_REDIRECT_URI="https://cloudcrackerfinalyearproject-1.onrender.com"

# Dynamic UPI Payment Configuration
UPI_PAYMENT_ID="cloudcrackers@upi"
UPI_PAYEE_NAME="CloudCrackers"
UPI_MERCHANT_ID=""

# SMTP / Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="your_email@gmail.com"

