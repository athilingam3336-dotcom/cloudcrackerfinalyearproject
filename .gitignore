# ==========================================
# CloudCrackers Git Ignore Policy
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
*.env.backup
backend/.env
frontend/.env
*.key
*.pem
*.cert

# Allow version-controlled sample environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Process & runtime IDs
*.pid
backend/uvicorn.pid
backend/*.pid

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/
.venv/
venv/
env/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Expo & Mobile Builds
.expo/
frontend/.expo/
dist/
frontend/dist/
web-build/
frontend/web-build/
*.jks
*.p8
*.p12
*.mobileprovision

# Database & Local Binary Storage
backend/mongodb_data/
backend/mongodb_bin/
backend/mongosh-*/
backend/mongosh-*.tgz
backend/mongodb-compass_*.deb

# Logs
logs/
backend/logs/
*.log

# Personal Developer / Interview Notes
athi/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
