# API Base URL
EXPO_PUBLIC_API_URL=https://cloudcrackerfinalyearproject.onrender.com/api/v1

# Toggle mock data mode (true/false)
EXPO_PUBLIC_ENABLE_MOCK=false

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# If left empty, CloudCrackers uses the built-in Google Account Chooser popup
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Google Gemini API Key for Meera Admin AI Copilot
EXPO_PUBLIC_GEMINI_API_KEY=
